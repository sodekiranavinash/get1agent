# Local development only. Copy to .env.local (gitignored) and adjust.
#
# Database used by `make account-settings`, `make migration-runner` and `make migrate-*`.
DATABASE_URL=postgresql+asyncpg://postgres:avinash123@localhost:5432/postgres

# Name reported by `make health-check` (cosmetic locally).
DB_NAME=postgres

# Optional: override the local runner port (defaults per app: 9001/9002/9003).
# PORT=9001
