{
  "Comment": "Ingest one document: Extract (VPC) -> Embed (no VPC) -> Index (VPC). Any stage failure records which stage failed, then marks the document failed. Runs as STANDARD so long ingestions are not cut off by the EXPRESS 5-minute cap; TimeoutSeconds is the safety bound.",
  "StartAt": "Extract",
  "TimeoutSeconds": 3600,
  "States": {
    "Extract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${extract_function_arn}",
        "Payload": {
          "documentId.$": "$.documentId",
          "knowledgeBaseId.$": "$.knowledgeBaseId",
          "userId.$": "$.userId",
          "s3Key.$": "$.s3Key"
        }
      },
      "ResultSelector": {
        "extracted.$": "$.Payload"
      },
      "Retry": [
        {
          "ErrorEquals": ["DocumentNotReady"],
          "IntervalSeconds": 2,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ExtractFailed"
        }
      ],
      "Next": "Embed"
    },
    "Embed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${embed_function_arn}",
        "Payload": {
          "documentId.$": "$.extracted.documentId",
          "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
          "userId.$": "$.extracted.userId",
          "chunksKey.$": "$.extracted.chunksKey",
          "images.$": "$.extracted.images",
          "config.$": "$.extracted.config"
        }
      },
      "ResultSelector": {
        "embeddingsKey.$": "$.Payload.embeddingsKey",
        "chunkCount.$": "$.Payload.chunkCount",
        "imageCount.$": "$.Payload.imageCount",
        "dimension.$": "$.Payload.dimension",
        "textModel.$": "$.Payload.textModel",
        "imageModel.$": "$.Payload.imageModel"
      },
      "ResultPath": "$.embedded",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "EmbedFailed"
        }
      ],
      "Next": "Index"
    },
    "Index": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${index_function_arn}",
        "Payload": {
          "documentId.$": "$.extracted.documentId",
          "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
          "userId.$": "$.extracted.userId",
          "chunksKey.$": "$.extracted.chunksKey",
          "embeddingsKey.$": "$.embedded.embeddingsKey",
          "images.$": "$.extracted.images",
          "config.$": "$.extracted.config"
        }
      },
      "ResultSelector": {
        "indexed.$": "$.Payload"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "IndexFailed"
        }
      ],
      "End": true
    },
    "ExtractFailed": {
      "Type": "Pass",
      "Parameters": {
        "documentId.$": "$.documentId",
        "knowledgeBaseId.$": "$.knowledgeBaseId",
        "userId.$": "$.userId",
        "error.$": "$.error",
        "stage": "extract"
      },
      "Next": "MarkFailed"
    },
    "EmbedFailed": {
      "Type": "Pass",
      "Parameters": {
        "documentId.$": "$.extracted.documentId",
        "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
        "userId.$": "$.extracted.userId",
        "error.$": "$.error",
        "stage": "embed"
      },
      "Next": "MarkFailed"
    },
    "IndexFailed": {
      "Type": "Pass",
      "Parameters": {
        "documentId.$": "$.extracted.documentId",
        "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
        "userId.$": "$.extracted.userId",
        "error.$": "$.error",
        "stage": "index"
      },
      "Next": "MarkFailed"
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${mark_failed_function_arn}",
        "Payload": {
          "documentId.$": "$.documentId",
          "knowledgeBaseId.$": "$.knowledgeBaseId",
          "userId.$": "$.userId",
          "stage.$": "$.stage",
          "error.$": "$.error"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": null,
      "Next": "Failed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "IngestionFailed",
      "Cause": "Document ingestion failed"
    }
  }
}
