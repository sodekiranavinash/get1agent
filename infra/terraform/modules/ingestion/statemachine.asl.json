{
  "Comment": "Ingest one document: Extract -> Embed -> Index -> (Graph RAG) GraphExtract. Any stage failure records which stage failed, then marks the document failed. GraphExtract is gated on the knowledge base's retrieval mode (Choice) so only Graph RAG knowledge bases pay the LLM extraction cost, and it is best-effort: a failure there is caught and the document still succeeds (its hybrid index is already written). Runs as STANDARD so long ingestions are not cut off by the EXPRESS 5-minute cap; TimeoutSeconds is the safety bound. Every stage retries the Lambda *service* exceptions (Lambda.TooManyRequestsException and friends) with backoff: they are not matched by States.TaskFailed, and they are what a burst of ingestions produces on an account whose concurrency limit is small — a corpus upload of 47 documents failed 10 of them at the extract stage before this retrier existed.",
  "StartAt": "Extract",
  "TimeoutSeconds": 3600,
  "States": {
    "Extract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${extract_function_arn}",
        "Payload": {
          "documentId.$": "$.documentId",
          "knowledgeBaseId.$": "$.knowledgeBaseId",
          "userId.$": "$.userId",
          "s3Key.$": "$.s3Key"
        }
      },
      "ResultSelector": {
        "extracted.$": "$.Payload"
      },
      "Retry": [
        {
          "ErrorEquals": ["DocumentNotReady"],
          "IntervalSeconds": 2,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 8,
          "BackoffRate": 2.0,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ExtractFailed"
        }
      ],
      "Next": "Embed"
    },
    "Embed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${embed_function_arn}",
        "Payload": {
          "documentId.$": "$.extracted.documentId",
          "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
          "userId.$": "$.extracted.userId",
          "chunksKey.$": "$.extracted.chunksKey",
          "images.$": "$.extracted.images",
          "config.$": "$.extracted.config"
        }
      },
      "ResultSelector": {
        "embeddingsKey.$": "$.Payload.embeddingsKey",
        "chunkCount.$": "$.Payload.chunkCount",
        "imageCount.$": "$.Payload.imageCount",
        "dimension.$": "$.Payload.dimension",
        "textModel.$": "$.Payload.textModel",
        "imageModel.$": "$.Payload.imageModel"
      },
      "ResultPath": "$.embedded",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 8,
          "BackoffRate": 2.0,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "EmbedFailed"
        }
      ],
      "Next": "Index"
    },
    "Index": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${index_function_arn}",
        "Payload": {
          "documentId.$": "$.extracted.documentId",
          "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
          "userId.$": "$.extracted.userId",
          "chunksKey.$": "$.extracted.chunksKey",
          "embeddingsKey.$": "$.embedded.embeddingsKey",
          "images.$": "$.extracted.images",
          "config.$": "$.extracted.config"
        }
      },
      "ResultPath": "$.indexed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 8,
          "BackoffRate": 2.0,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "IndexFailed"
        }
      ],
      "Next": "GraphMode"
    },
    "GraphMode": {
      "Type": "Choice",
      "Comment": "Only Graph RAG knowledge bases build a graph; hybrid KBs skip straight to done.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.extracted.config.retrieval_mode",
              "IsPresent": true
            },
            {
              "Variable": "$.extracted.config.retrieval_mode",
              "StringEquals": "graph"
            }
          ],
          "Next": "GraphExtract"
        }
      ],
      "Default": "GraphDone"
    },
    "GraphExtract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${graph_function_arn}",
        "Payload": {
          "documentId.$": "$.extracted.documentId",
          "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
          "userId.$": "$.extracted.userId",
          "chunksKey.$": "$.extracted.chunksKey",
          "config.$": "$.extracted.config"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "MaxDelaySeconds": 60
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.graphError",
          "Next": "GraphDone"
        }
      ],
      "Next": "GraphDone"
    },
    "GraphDone": {
      "Type": "Succeed"
    },
    "ExtractFailed": {
      "Type": "Pass",
      "Parameters": {
        "documentId.$": "$.documentId",
        "knowledgeBaseId.$": "$.knowledgeBaseId",
        "userId.$": "$.userId",
        "error.$": "$.error",
        "stage": "extract"
      },
      "Next": "MarkFailed"
    },
    "EmbedFailed": {
      "Type": "Pass",
      "Parameters": {
        "documentId.$": "$.extracted.documentId",
        "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
        "userId.$": "$.extracted.userId",
        "error.$": "$.error",
        "stage": "embed"
      },
      "Next": "MarkFailed"
    },
    "IndexFailed": {
      "Type": "Pass",
      "Parameters": {
        "documentId.$": "$.extracted.documentId",
        "knowledgeBaseId.$": "$.extracted.knowledgeBaseId",
        "userId.$": "$.extracted.userId",
        "error.$": "$.error",
        "stage": "index"
      },
      "Next": "MarkFailed"
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${mark_failed_function_arn}",
        "Payload": {
          "documentId.$": "$.documentId",
          "knowledgeBaseId.$": "$.knowledgeBaseId",
          "userId.$": "$.userId",
          "stage.$": "$.stage",
          "error.$": "$.error"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": null,
      "Next": "Failed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "IngestionFailed",
      "Cause": "Document ingestion failed"
    }
  }
}
