# Template for the local Floci stack config. `make floci-*` copies this file to
# the repo-root `.env` (which is gitignored) when it does not exist, and reads it
# via `docker compose --env-file .env`. Everything the local stack needs lives
# here — grouped by concern. Values are blank where a secret/credential is
# required; URLs and defaults are pre-filled.

# =============================================================================
# Floci stack (containers, ports, images) — host plumbing
# =============================================================================
FLOCI_IMAGE=floci/floci:latest-compat
FLOCI_PORT=4566
FLOCI_HOSTNAME=localhost.floci.io
FLOCI_STORAGE_MODE=persistent
FLOCI_INIT_HOOKS_TIMEOUT_SECONDS=300
FLOCI_DEFAULT_ACCOUNT_ID=000000000000
DYNAMODB_PORT=8000
LOCAL_EMBED_PORT=11434
RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
RERANKER_PORT=8080

# =============================================================================
# AWS / Floci (host CLI + ad-hoc boto3)
# =============================================================================
# Credentials are deliberately NOT set here. Host processes use your normal AWS
# chain (exported env vars, ~/.aws profiles, SSO). `make floci-up` resolves the
# same chain with `aws configure export-credentials` and passes it to the Floci
# container, so real AWS services work inside the local Lambdas too.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
# Services Floci emulates (S3, DynamoDB, Lambda, KMS, …) go to the emulator…
AWS_ENDPOINT_URL=http://localhost.floci.io:4566
# …but Bedrock is not emulated, so send it to real AWS (keep in sync with
# BEDROCK_REGION below).
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=https://bedrock-runtime.ap-south-1.amazonaws.com

# =============================================================================
# Data plane (S3 + DynamoDB)
# =============================================================================
# S3_ENDPOINT_URL is read by the locally-run agent runtime (S3 sessions).
S3_BUCKET=get1agent-local
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost.floci.io:4566
DYNAMODB_TABLE=get1agent-local
DYNAMODB_ENDPOINT_URL=http://dynamodb:8000
VECTOR_STORE=local

# =============================================================================
# Auth0 / identity
# =============================================================================
# Floci verifies real Auth0 tokens via OIDC/JWKS, so the container needs
# network access to the issuer.
AUTH_ISSUER=https://get1agent.us.auth0.com/
AUTH_AUDIENCE=https://api.get1agent.com
AUTH_TOKEN_URL=
AGENT_SERVICE_CLIENT_ID=
AGENT_SERVICE_CLIENT_SECRET=
SERVICE_AUTH_CLIENT_ID=
AUTH_MGMT_CLIENT_ID=
AUTH_MGMT_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Embedding backend
# =============================================================================
# EMBED_MODE: local (Ollama, offline) | bedrock (real Titan; needs AWS creds).
EMBED_MODE=local
EMBED_DIM=1024
LOCAL_EMBED_URL=http://ollama:11434
LOCAL_EMBED_MODEL=mxbai-embed-large
EMBED_MAX_WORKERS=4
EMBED_MAX_ATTEMPTS=6
TEXT_EMBED_MODEL=amazon.titan-embed-text-v2:0
IMAGE_EMBED_MODEL=amazon.titan-embed-image-v1
EMBED_IMAGES=false

# =============================================================================
# Rerank backend (opt-in per request)
# =============================================================================
# RERANK_MODE: local (TEI cross-encoder) | none | bedrock (cross-region).
RERANK_MODE=none
RERANK_REGION=us-west-2
RERANK_MODEL_ARN=arn:aws:bedrock:us-west-2::foundation-model/amazon.rerank-v1:0
LOCAL_RERANK_URL=http://reranker:80/rerank
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
LOCAL_RERANK_TIMEOUT_SECONDS=60
LOCAL_RERANK_BATCH_SIZE=32

# =============================================================================
# LLM gateway — Amazon Bedrock (agent models, evals, Playground generation)
# =============================================================================
# Bedrock is IAM-authenticated; local containers need AWS credentials.
BEDROCK_REGION=ap-south-1
BEDROCK_CHAT_MODEL=zai.glm-4.7-flash
CUSTOM_TOOLS_GENERATOR_MODEL=zai.glm-4.7-flash
CUSTOM_TOOLS_GENERATE_MAX_TOKENS=32000
CUSTOM_TOOLS_GENERATE_TIMEOUT_SECONDS=25
CUSTOM_TOOLS_GENERATE_ASYNC_TIMEOUT_SECONDS=240
EVAL_ANSWER_MODEL=amazon.nova-2-lite-v1:0
EVAL_JUDGE_MODEL=amazon.nova-2-lite-v1:0
EVAL_MAX_CASES_PER_RUN=20

# AgentCore Memory + Policy (A1/A2). Defaults keep the in-app memory + no policy.
AGENT_MEMORY_BACKEND=dynamo
# Managed MCP gateway (A3). Locally the in-app servers are used directly.
MCP_TRANSPORT=aggregator
# AgentCore Identity (A4). Empty values disable it; local dev uses the Vault.
AGENT_WORKLOAD_IDENTITY_ARN=
AGENT_TOKEN_VAULT_ID=
AGENT_IDENTITY_PROVIDERS=
AGENT_IDENTITY_RETURN_URL=
MCP_GATEWAY_URL=
AGENTCORE_MEMORY_ID=
AGENT_POLICY_ENGINE=
AGENT_POLICY_MODE=enforce
AGENT_POLICY_DENY_TOOLS=

# Bedrock Guardrails (AWS-native safety). Empty GUARDRAIL_ID disables it.
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# =============================================================================
# Agent runtime (runs as the `agent` container in the Floci stack)
# =============================================================================
AGENT_PORT=8090
AGENT_PLANNER_ENABLED=true
AGENT_PLANNER_MODEL=zai.glm-4.7-flash
AGENT_PLANNER_HISTORY_TURNS=6
AGENT_MAX_TURNS=40
AGENT_SESSION_PREFIX=agent-sessions/
AGENT_MAX_ATTACHMENTS=5
AGENT_ATTACHMENT_MAX_CHARS=20000
AGENT_CONTEXT_WINDOW=
AGENT_CONTEXT_COMPRESSION_THRESHOLD=0.9
AGENT_CONTEXT_FULL_RATIO=0.9
AGENT_TOOL_RESULT_MAX_CHARS=1500
AGENT_TOOL_RESULT_KEEP_FULL=2
AGENT_TOOL_RESULT_RECENT_CHARS=6000
# Optional direct X-Ray export for local agent runs (needs AWS credentials).
AGENT_XRAY_EXPORT=false
AGENT_XRAY_REGION=ap-south-1

# =============================================================================
# Agent runtime — MCP server wiring (local Floci Lambda names)
# =============================================================================
KNOWLEDGE_MCP_FUNCTION=get1agent-local-knowledge-mcp
CODE_INTERPRETER_MCP_FUNCTION=get1agent-local-code-interpreter
HTTP_FETCH_MCP_FUNCTION=get1agent-local-http-fetch
REMOTE_MCP_FUNCTION=get1agent-local-mcp-connections
CUSTOM_TOOLS_MCP_FUNCTION=get1agent-local-custom-tools
AGENT_RUN_FUNCTION=

# =============================================================================
# Code interpreter (Floci runs it as a guarded local subprocess)
# =============================================================================
CODE_INTERPRETER_MODE=local
CODE_INTERPRETER_EXEC_TIMEOUT_SECONDS=120
BLOCKED_MODULES=
ALLOWED_MODULES=

# =============================================================================
# Custom tools / MCP Builder (Floci runs it as a guarded local subprocess)
# =============================================================================
CUSTOM_TOOLS_MODE=local
CUSTOM_TOOLS_EXEC_TIMEOUT_SECONDS=60
CUSTOM_TOOLS_SESSION_TIMEOUT_SECONDS=900
CUSTOM_TOOLS_MAX_SESSIONS_PER_USER=1
CUSTOM_TOOLS_MAX_CODE_BYTES=65536
CUSTOM_TOOLS_MAX_OUTPUT_CHARS=50000
CUSTOM_TOOLS_MAX_RESULT_CHARS=20000

# =============================================================================
# Web search (Amazon Bedrock AgentCore Web Search connector)
# =============================================================================
# Web Search is the AgentCore Gateway built-in connector — no MCP Lambda and no
# model access. It is NOT available in ap-south-1; it runs on a dedicated
# gateway in a supported Region (us-east-1, eu-west-1 or ap-northeast-1).
# Set WEB_SEARCH_GATEWAY_URL to that gateway's URL to enable it LOCALLY too.
WEB_SEARCH_GATEWAY_TOOL=web-search___WebSearch
WEB_SEARCH_GATEWAY_URL=
WEB_SEARCH_GATEWAY_REGION=ap-northeast-1

# =============================================================================
# HTTP fetch (trusted fetch + user storage)
# =============================================================================
HTTP_FETCH_ALLOWED_DOMAINS=

# =============================================================================
# Vault (encrypted user secrets)
# =============================================================================
VAULT_TEST_TIMEOUT_SECONDS=15
VAULT_ALLOW_PRIVATE_URLS=true

# =============================================================================
# Remote MCP connections (GitHub OAuth App + registries)
# =============================================================================
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/v1/mcp/oauth/callback
MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
SKILLS_REGISTRY_URL=https://api.claude-plugins.dev

# =============================================================================
# Cache (DynamoDB TTL) — embeddings + knowledge search, normal path only
# =============================================================================
CACHE_BACKEND=dynamodb
CACHE_SEARCH_TTL_SECONDS=300
CACHE_EMBEDDING_TTL_SECONDS=2592000

# =============================================================================
# Semantic cache: S3 Vectors ANN (per-user) + DynamoDB payload
# =============================================================================
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=600
SEMANTIC_CACHE_MAX_BYTES=200000

# =============================================================================
# Single-flight locks (DynamoDB conditional write) — dedupe concurrent work
# =============================================================================
SINGLE_FLIGHT_ENABLED=true
SINGLE_FLIGHT_LOCK_SECONDS=20
SINGLE_FLIGHT_WAIT_SECONDS=6

# =============================================================================
# Signed trace links (user-api)
# =============================================================================
# HMAC secret for the public, 30-minute expiring trace links. Generate with:
#   openssl rand -hex 32
TRACE_LINK_SECRET=

# =============================================================================
# Scheduler
# =============================================================================
# AgentCore is not emulated locally, so scheduled runs cannot execute; leave off.
ENABLE_LOCAL_SCHEDULER=false
ENABLE_LOCAL_WATCHDOG=false
