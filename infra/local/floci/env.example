# Template for the local Floci stack config. `make floci-*` copies this to `.env`
# if `.env` does not exist. `.env` is gitignored.

# --- AWS / Floci (host CLI / ad-hoc boto3) ---
# Floci injects AWS_ENDPOINT_URL into Lambda containers automatically.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost.floci.io:4566

# --- S3 data bucket (Floci) ---
S3_BUCKET=get1agent-local

# --- DynamoDB Local (single table + GSIs) ---
DYNAMODB_TABLE=get1agent-local
# Reachable from the host and from Floci/Lambda containers on the compose network.
DYNAMODB_ENDPOINT_URL=http://dynamodb:8000

# --- Auth0 (used by the Floci HTTP API JWT authorizer) ---
# Floci verifies real Auth0 tokens via OIDC/JWKS, so the Floci container needs
# network access to the issuer.
AUTH0_ISSUER=https://get1agent.us.auth0.com/
AUTH0_AUDIENCE=https://api.get1agent.com

# --- Embedding backend ---
# EMBED_MODE selects how vectors are created:
#   voyage -> the Voyage AI API (default; set VOYAGE_API_KEY); no AWS/Bedrock
#   local  -> the Ollama container below (fully offline)
#   bedrock -> Amazon Titan (only once Bedrock access is added)
EMBED_MODE=voyage

# --- Local embeddings (real vectors via Ollama, no Bedrock) ---
# `make floci` pulls this model into the Ollama container (1024-dim).
LOCAL_EMBED_MODEL=mxbai-embed-large

# --- Voyage AI (embeddings + reranker; the default) ---
# Get a key at https://dashboard.voyageai.com. The Floci Lambda containers call
# api.voyageai.com directly over public HTTPS (like the Exa tool). Both embed
# models default to 1024 dimensions, matching EMBED_DIM.
VOYAGE_API_KEY=
VOYAGE_API_BASE_URL=https://api.voyageai.com/v1
VOYAGE_TEXT_MODEL=voyage-4-large
VOYAGE_MULTIMODAL_MODEL=voyage-multimodal-3.5
VOYAGE_RERANK_MODEL=rerank-3

# --- OpenCode Go (agent LLMs; used by backend/agents) ---
# Get a key at https://opencode.ai. The agent runtime calls the OpenAI-compatible
# /chat/completions endpoint. Run it locally with:
#   make -C backend/agents run
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
AGENT_PLANNER_MODEL=deepseek-v4-flash-vision-exp

# --- Rerank backend ---
# RERANK_MODE: voyage (default; opt-in per request) | local (TEI) | none | bedrock
RERANK_MODE=voyage

# --- Local reranker (offline cross-encoder via HuggingFace TEI) ---
# Only started/waited on when RERANK_MODE=local. TEI's CPU image is amd64;
# Apple Silicon runs it under Rosetta. Pick a larger model for quality:
# BAAI/bge-reranker-base (~1.1 GB).
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_PORT=8080

# --- Exa web-search tool ---
# Get a key at https://dashboard.exa.ai/api-keys. The web-search tool calls
# api.exa.ai directly from the Floci Lambda containers (public HTTPS).
EXA_API_KEY=
EXA_API_BASE_URL=https://api.exa.ai

# --- Remote MCP connections (GitHub) ---
# Register a GitHub OAuth App (Settings -> Developer settings -> OAuth Apps),
# then paste its client id/secret here. Add the redirect URIs below to the app
# (GitHub now supports multiple redirect URIs). In the app settings:
#   - Allow wildcard matching: off
#   - Enable Device Flow: off (we use the browser Authorization Code + PKCE flow)
#   - Expire user access tokens: ON (8h tokens + rotating refresh tokens; the
#     connection refreshes lazily and persists the rotated refresh token)
# Providers reject plaintext-HTTP redirect URIs unless they are a loopback
# address (localhost / 127.0.0.1), and Floci only serves the API on its own
# host. Easiest: run the loopback forwarder and register its URL as the app's
# callback (works for Linear, GitHub, …):
#     make floci-oauth-proxy
#     MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/v1/mcp/oauth/callback
# Alternative for providers that demand HTTPS: a tunnel, e.g.
#     ngrok http --host-header=get1agent.execute-api.localhost.floci.io 4566
#     MCP_OAUTH_REDIRECT_URI=https://<id>.ngrok.app/v1/mcp/oauth/callback
# Production callback: https://api.get1agent.com/v1/mcp/oauth/callback
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
# Override only when using the loopback proxy or a tunnel; else the default is used.
MCP_OAUTH_REDIRECT_URI=
# SPA origin the callback redirects back to (the Vite dev server locally).
FRONTEND_URL=http://localhost:5173
